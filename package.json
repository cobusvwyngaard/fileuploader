{
  "name": "fileuploader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-hosted upload sessions that deliver files straight to OneDrive for Business and report them to Excel Online.",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite",
    "build": "npm run build:web",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run typecheck && npm test && npm run build:web && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "smoke": "node scripts/smoke-test.mjs",
    "gen:key": "node scripts/generate-key.mjs"
  },
  "dependencies": {
    "hono": "4.13.13",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "5.20261018.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
